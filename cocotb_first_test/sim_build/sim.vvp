#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5feb25a6d4c0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5feb25a6d650 .scope module, "adder" "adder" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 4 "a";
    .port_info 1 /INPUT 4 "b";
    .port_info 2 /OUTPUT 5 "sum";
v0x5feb25a33620_0 .net *"_ivl_0", 4 0, L_0x5feb25a7dba0;  1 drivers
L_0x76980cb57018 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x5feb25a7d5b0_0 .net *"_ivl_3", 0 0, L_0x76980cb57018;  1 drivers
v0x5feb25a7d690_0 .net *"_ivl_4", 4 0, L_0x5feb25a7dcf0;  1 drivers
L_0x76980cb57060 .functor BUFT 1, C4<0>, C4<0>, C4<0>, C4<0>;
v0x5feb25a7d750_0 .net *"_ivl_7", 0 0, L_0x76980cb57060;  1 drivers
o0x76980cba00d8 .functor BUFZ 4, C4<zzzz>; HiZ drive
v0x5feb25a7d830_0 .net "a", 3 0, o0x76980cba00d8;  0 drivers
o0x76980cba0108 .functor BUFZ 4, C4<zzzz>; HiZ drive
v0x5feb25a7d960_0 .net "b", 3 0, o0x76980cba0108;  0 drivers
v0x5feb25a7da40_0 .net "sum", 4 0, L_0x5feb25a7de40;  1 drivers
L_0x5feb25a7dba0 .concat [ 4 1 0 0], o0x76980cba00d8, L_0x76980cb57018;
L_0x5feb25a7dcf0 .concat [ 4 1 0 0], o0x76980cba0108, L_0x76980cb57060;
L_0x5feb25a7de40 .arith/sum 5, L_0x5feb25a7dba0, L_0x5feb25a7dcf0;
S_0x5feb25a33490 .scope module, "cocotb_iverilog_dump" "cocotb_iverilog_dump" 4 1;
 .timescale -9 -12;
    .scope S_0x5feb25a6d650;
T_0 ;
    %vpi_call/w 3 9 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 10 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5feb25a6d650 {0 0 0};
    %end;
    .thread T_0;
    .scope S_0x5feb25a33490;
T_1 ;
    %vpi_call/w 4 3 "$dumpfile", "sim_build/adder.fst" {0 0 0};
    %vpi_call/w 4 4 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5feb25a6d650 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "/home/veysel/Desktop/cocotb_tutorial/cocotb_first_test/adder.v";
    "sim_build/cocotb_iverilog_dump.v";
